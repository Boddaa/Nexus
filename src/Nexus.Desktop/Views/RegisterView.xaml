<UserControl x:Class="Nexus.Desktop.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid Background="{StaticResource BgDarkestBrush}">
        <Border Style="{StaticResource ModernCard}"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Margin="10">
                <!-- Logo & Title -->
                <TextBlock Text="🚀 Create Account"
                           FontSize="26"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentPrimaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6" />
                <TextBlock Text="Join NEXUS Knowledge Workspace"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24" />

                <!-- Error Message -->
                <Border Background="#371B22"
                        BorderBrush="{StaticResource AccentRoseBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10"
                        Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={x:Null}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource AccentRoseBrush}"
                               TextWrapping="Wrap"
                               FontSize="13" />
                </Border>

                <!-- Full Name -->
                <TextBlock Text="Full Name"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,16" />

                <!-- Email Input -->
                <TextBlock Text="Email Address"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,16" />

                <!-- Password Input -->
                <TextBlock Text="Password"
                           FontSize="13"
                           FontWeight="Medium"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,6" />
                <TextBox Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Margin="0,0,0,24" />

                <!-- Register Button -->
                <Button Content="Create Account"
                        Command="{Binding RegisterCommand}"
                        Style="{StaticResource PrimaryButton}"
                        Height="44"
                        Margin="0,0,0,16" />

                <!-- Go to Login Link -->
                <Button Content="Already have an account? Sign In"
                        Command="{Binding GoToLoginCommand}"
                        Style="{StaticResource SecondaryButton}"
                        Height="38" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
