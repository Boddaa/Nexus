<UserControl x:Class="Nexus.Desktop.Views.PagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dtos="clr-namespace:Nexus.Application.DTOs.Pages;assembly=Nexus.Application"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT COLUMN: Page Hierarchy Tree -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Actions -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📄 Pages" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Hierarchical Structure" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding RefreshCommand}"
                            Padding="8,6"
                            Margin="0,0,6,0"
                            ToolTip="Refresh Page Tree">
                        <TextBlock Text="🔄" FontSize="14" />
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding OpenCreateDialogCommand}"
                            Padding="12,6"
                            ToolTip="Create New Root Page">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="Add Page" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Loading Indicator -->
                <ProgressBar Grid.Row="1" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                             Foreground="{StaticResource AccentPrimaryBrush}" Background="Transparent" BorderThickness="0" />

                <!-- TreeView of Pages -->
                <TreeView Grid.Row="1"
                          ItemsSource="{Binding PageTree}"
                          Background="Transparent"
                          BorderThickness="0"
                          Margin="0,4,0,0">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type dtos:PageTreeNodeDto}" ItemsSource="{Binding Children}">
                            <Border Padding="6,6" Margin="0,2" CornerRadius="6" Cursor="Hand" Background="Transparent">
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectPageCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding Children.Count}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,4,0" VerticalAlignment="Center"
                                                Visibility="{Binding Children.Count, Converter={StaticResource GreaterThanZeroToVisConverter}}" />
                                </Grid>
                            </Border>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>

        <!-- 2. RIGHT COLUMN: Page Editor & Details -->
        <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="24">
            <Grid>
                <!-- When No Page is Selected -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasSelectedPage, Converter={StaticResource InverseBoolToVisConverter}}">
                    <TextBlock Text="📄" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="No Page Selected" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a page from the tree on the left, or create a new one to begin writing." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,20" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenCreateDialogCommand}" HorizontalAlignment="Center" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Create New Page" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- When Page IS Selected -->
                <Grid Visibility="{Binding HasSelectedPage, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Feedback Banners -->
                    <Border Grid.Row="0" Background="{StaticResource BgHoverBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="13" FontWeight="Medium" />
                    </Border>
                    <Border Grid.Row="0" Background="#3B1824" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentRoseBrush}" FontSize="13" FontWeight="Medium" />
                    </Border>

                    <!-- Action Bar Header -->
                    <Grid Grid.Row="1" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Icon & Title -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding EditorIcon, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 Width="48" FontSize="20"
                                 HorizontalContentAlignment="Center"
                                 Margin="0,0,12,0" />

                        <TextBox Grid.Column="1"
                                 Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 FontSize="18" FontWeight="Bold" />

                        <!-- Buttons Group -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SavePageCommand}"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Save" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenCreateDialogCommand}"
                                    CommandParameter="child"
                                    Margin="0,0,8,0"
                                    ToolTip="Add child page under this page">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="➕" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Sub-page" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SecondaryButton}"
                                    Command="{Binding OpenMoveDialogCommand}"
                                    Margin="0,0,8,0"
                                    ToolTip="Move this page to another parent or order">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚚" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Move" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource DangerButton}"
                                    Command="{Binding DeletePageCommand}"
                                    ToolTip="Soft-delete this page and subpages">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Delete" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Meta Information & Badges -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Background="{StaticResource BgInputBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ChildPagesCount, StringFormat='📑 {0} Sub-pages'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Border Background="{StaticResource BgInputBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,10,0">
                            <TextBlock Text="{Binding NotesCount, StringFormat='📝 {0} Attached Notes'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Border Background="{StaticResource BgInputBrush}" CornerRadius="6" Padding="10,4">
                            <TextBlock Text="{Binding EditorOrderIndex, StringFormat='🔢 Order: {0}'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- AI Intelligence Quick Actions -->
                    <Border Grid.Row="3" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🧠 AI WORKFLOWS:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="✨ Summarize" Command="{Binding RunAiOperationOnPageCommand}" CommandParameter="Summarize" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="💡 Explain" Command="{Binding RunAiOperationOnPageCommand}" CommandParameter="Explain" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="📌 Key Points" Command="{Binding RunAiOperationOnPageCommand}" CommandParameter="Extract Key Points" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="❓ Quiz" Command="{Binding RunAiOperationOnPageCommand}" CommandParameter="Generate Questions" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="🎓 Study Guide" Command="{Binding RunAiOperationOnPageCommand}" CommandParameter="Study Material" Style="{StaticResource SecondaryButton}" Padding="8,4" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Content Editor -->
                    <Border Grid.Row="4" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                <TextBlock Text="Page Content Structure (JSON / Data Schema)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                            </Border>

                            <TextBox Grid.Row="1"
                                     Text="{Binding EditorContentJson, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     Background="Transparent"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     CaretBrush="{StaticResource AccentPrimaryBrush}"
                                     BorderThickness="0"
                                     Padding="14"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="13" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 3. CREATE PAGE MODAL OVERLAY -->
        <Grid Grid.ColumnSpan="3" Background="#99000000"
              Visibility="{Binding IsCreateDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Style="{StaticResource ModernCard}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="➕ Create New Page" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="Title" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewPageTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,14" />

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Icon" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding NewPageIcon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Width="60" HorizontalContentAlignment="Center" FontSize="18" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Parent Page" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <ComboBox ItemsSource="{Binding ParentPageOptions}"
                                      SelectedValue="{Binding NewPageParentId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Title"
                                      Padding="8,8"
                                      Background="{StaticResource BgInputBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Order Index" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding NewPageOrderIndex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20" />

                    <!-- Modal Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CloseCreateDialogCommand}" Margin="0,0,10,0" Padding="16,8" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Create Page" Command="{Binding CreatePageCommand}" Padding="18,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. MOVE PAGE MODAL OVERLAY -->
        <Grid Grid.ColumnSpan="3" Background="#99000000"
              Visibility="{Binding IsMoveDialogOpen, Converter={StaticResource BoolToVisConverter}}">
            <Border Style="{StaticResource ModernCard}" Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="24">
                <StackPanel>
                    <TextBlock Text="🚚 Move Page" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBlock Text="Change the parent page or ordering in the hierarchy." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />

                    <TextBlock Text="Target Parent Page" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <ComboBox ItemsSource="{Binding ParentPageOptions}"
                              SelectedValue="{Binding MoveTargetParentId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Title"
                              Padding="8,8"
                              Margin="0,0,0,16"
                              Background="{StaticResource BgInputBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}" />

                    <TextBlock Text="New Order Index" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />
                    <TextBox Text="{Binding MoveNewOrderIndex, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,20" />

                    <!-- Modal Actions -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="Cancel" Command="{Binding CloseMoveDialogCommand}" Margin="0,0,10,0" Padding="16,8" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Confirm Move" Command="{Binding MovePageCommand}" Padding="18,8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
