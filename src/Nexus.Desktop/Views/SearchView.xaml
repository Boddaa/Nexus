<UserControl x:Class="Nexus.Desktop.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="🔍 Knowledge Search" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="Search across all Pages, Notes, and Documents in your active workspace." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- 2. SEARCH INPUT & ACTION -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource ModernTextBox}"
                     FontSize="15"
                     Padding="14,10">
                <TextBox.InputBindings>
                    <KeyBinding Key="Return" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>

            <Button Grid.Column="2"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SearchCommand}"
                    Padding="22,10"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔎" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Search" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 3. TYPE FILTER & STATS ROW -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Mode Selector -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Mode:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding SearchModeOptions}"
                          SelectedItem="{Binding SelectedSearchMode}"
                          Style="{StaticResource ModernComboBox}"
                          Width="120" />
            </StackPanel>

            <!-- Filter Dropdown / Combo -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Filter by Type:" FontSize="13" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding TypeFilterOptions}"
                          SelectedItem="{Binding SelectedTypeFilter}"
                          Style="{StaticResource ModernComboBox}"
                          Width="130" />
            </StackPanel>

            <!-- Result Count Stats -->
            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HasSearched, Converter={StaticResource BoolToVisConverter}}">
                <TextBlock Text="{Binding TotalCount, StringFormat='Found {0:N0} match(es)'}"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="Medium" />
            </StackPanel>
        </Grid>

        <!-- FEEDBACK MESSAGES -->
        <Border Grid.Row="2" Background="#3B1824" CornerRadius="8" Padding="14,10" Margin="0,40,0,0"
                VerticalAlignment="Top"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentRoseBrush}" FontSize="13" FontWeight="Medium" />
        </Border>

        <!-- 4. RESULTS CONTAINER -->
        <Border Grid.Row="3" Style="{StaticResource ModernCard}" Padding="16">
            <Grid>
                <!-- Initial State (Before searching) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasSearched, Converter={StaticResource InverseBoolToVisConverter}}">
                    <TextBlock Text="🔍" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="Explore Your Knowledge Base" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Type any keyword, phrase, or title above and hit Search or press Enter." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Empty Results State (Searched, but 0 matches) -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSearched}" Value="True" />
                                        <Condition Binding="{Binding HasResults}" Value="False" />
                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="📂" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="No Results Found" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="No items in this workspace match your query. Try broadening your keywords or clearing filters." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Results List -->
                <ListBox ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult}"
                         Style="{StaticResource ModernListBox}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding HasResults, Converter={StaticResource BoolToVisConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgDarkBrush}"
                                    BorderBrush="{StaticResource BorderLightBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="16,14"
                                    Margin="0,0,0,10"
                                    Cursor="Hand">
                                <Border.InputBindings>
                                    <MouseBinding Gesture="LeftClick"
                                                  Command="{Binding DataContext.OpenResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Title, Type Badge, Score Badge -->
                                    <Grid Grid.Row="0" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="📑 " FontSize="14" VerticalAlignment="Center"
                                                       Visibility="{Binding Type, Converter={StaticResource StringNotEmptyToVisConverter}}" />
                                            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="520" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource BgHoverBrush}" CornerRadius="4" Padding="7,2" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="#1E293B" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                    Visibility="{Binding SearchMode, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                                <TextBlock Text="{Binding SearchMode}" FontSize="10" Foreground="{StaticResource AccentCyanBrush}" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Background="{StaticResource BgInputBrush}" CornerRadius="4" Padding="6,2">
                                                <TextBlock Text="{Binding Score, StringFormat='Score: {0:F0}'}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" FontWeight="Medium" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Middle Row: Snippet -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Snippet}"
                                               FontSize="13"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,10" />

                                    <!-- Bottom Row: Metadata & Open Link -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding CreatedAtUtc, StringFormat='Created {0:yyyy-MM-dd HH:mm}'}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1"
                                                   Text="Open item ➔"
                                                   FontSize="12"
                                                   Foreground="{StaticResource AccentBlueBrush}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 5. PAGINATION CONTROLS -->
        <Grid Grid.Row="4" Margin="0,14,0,0"
              Visibility="{Binding HasResults, Converter={StaticResource BoolToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding PreviousPageCommand}"
                    Padding="14,6"
                    IsEnabled="{Binding CurrentPage, Converter={StaticResource InverseBoolConverter}}">
                <TextBlock Text="◀ Previous" FontSize="12" />
            </Button>

            <TextBlock Grid.Column="1"
                       Text="{Binding CurrentPage, StringFormat='Page {0} of {1}'}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextMutedBrush}" />

            <Button Grid.Column="2"
                    Style="{StaticResource SecondaryButton}"
                    Command="{Binding NextPageCommand}"
                    Padding="14,6">
                <TextBlock Text="Next ▶" FontSize="12" />
            </Button>
        </Grid>
    </Grid>
</UserControl>
