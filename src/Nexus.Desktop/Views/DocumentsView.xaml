<UserControl x:Class="Nexus.Desktop.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. TOP HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="📚 Knowledge Documents" FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Upload and parse PDFs, Word docs, Markdown, and text files into your knowledge workspace." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0" Padding="14,8"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔄" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Refresh" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource PrimaryButton}" Command="{Binding UploadDocumentCommand}" Padding="16,8"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Upload Document" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. FEEDBACK BANNERS -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <Border Background="{StaticResource BgHoverBrush}" CornerRadius="8" Padding="14,10"
                    Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="13" FontWeight="Medium" />
            </Border>
            <Border Background="#3B1824" CornerRadius="8" Padding="14,10"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentRoseBrush}" FontSize="13" FontWeight="Medium" />
            </Border>
        </Grid>

        <!-- 3. MAIN WORKSPACE: 2-COLUMN VIEW -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: Document List & Filters -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Bar -->
                    <TextBox Grid.Row="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernTextBox}"
                             Margin="0,0,0,10" />

                    <!-- Page Filter Dropdown -->
                    <ComboBox Grid.Row="1"
                              ItemsSource="{Binding PageFilterOptions}"
                              SelectedValue="{Binding SelectedPageFilterId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Title"
                              Style="{StaticResource ModernComboBox}"
                              Margin="0,0,0,12" />

                    <!-- Documents List -->
                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredDocuments}"
                             SelectedItem="{Binding SelectedDocumentSummary}"
                             Style="{StaticResource ModernListBox}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BgDarkBrush}"
                                        BorderBrush="{StaticResource BorderLightBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12"
                                        Margin="0,0,0,8"
                                        Cursor="Hand">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Top Row: File Name & Status -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="📄" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <Border Grid.Column="1" Background="{StaticResource BgCardBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="Medium" />
                                            </Border>
                                        </Grid>

                                        <!-- Bottom Row: Metadata & Page Badge -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="{StaticResource BgInputBrush}" CornerRadius="4" Padding="5,2" Margin="0,0,6,0"
                                                        Visibility="{Binding PageTitle, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                                    <TextBlock Text="{Binding PageTitle, StringFormat='📄 {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="140" />
                                                </Border>
                                                <TextBlock Text="{Binding FileExtension}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding FileSizeBytes, StringFormat='{}{0:N0} bytes'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Text="{Binding CreatedAtUtc, StringFormat='{}{0:MMM dd}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: Document Detail & Text Preview -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="24">
                <Grid>
                    <!-- Empty Selection State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasSelectedDocument, Converter={StaticResource InverseBoolToVisConverter}}">
                        <TextBlock Text="📚" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                        <TextBlock Text="No Document Selected" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Select a document from the left, or upload a new file to extract its content." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,20" HorizontalAlignment="Center" />
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding UploadDocumentCommand}" HorizontalAlignment="Center" Padding="20,10"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📤" FontSize="14" Margin="0,0,8,0" />
                                <TextBlock Text="Upload Document" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Active Document Details -->
                    <Grid Visibility="{Binding HasSelectedDocument, Converter={StaticResource BoolToVisConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header & Actions -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding SelectedDocument.FileName}" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="{StaticResource BgHoverBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SelectedDocument.Status}" FontSize="12" Foreground="{StaticResource AccentEmeraldBrush}" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding SelectedDocument.ContentType}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding SelectedDocument.FileSizeBytes, StringFormat='{}{0:N0} bytes'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Command="{Binding DownloadDocumentCommand}" Margin="0,0,8,0" Padding="14,8"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⬇️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Download" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteDocumentCommand}" Padding="14,8"
                                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🗑️" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Delete" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Metadata Stats Bar -->
                        <Border Grid.Row="1" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="PAGE LINK" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedDocument.PageTitle, TargetNullValue='None (Workspace Root)'}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="EXTRACTED TEXT" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedDocument.ExtractedTextLength, StringFormat='{}{0:N0} characters'}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="UPLOADED ON" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="{Binding SelectedDocument.CreatedAtUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Extracted Text Preview -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Extracted Text Preview" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                            <TextBox Grid.Row="1"
                                     Text="{Binding SelectedDocument.ExtractedText, Mode=OneWay}"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     Style="{StaticResource ModernTextBox}"
                                     Background="{StaticResource BgDarkBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     FontFamily="Consolas, Cascadia Code, Courier New"
                                     FontSize="13"
                                     Padding="12" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
