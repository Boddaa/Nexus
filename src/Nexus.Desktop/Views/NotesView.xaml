<UserControl x:Class="Nexus.Desktop.Views.NotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dtos="clr-namespace:Nexus.Application.DTOs.Notes;assembly=Nexus.Application"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. LEFT COLUMN: Notes List & Filters -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Actions -->
                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📝 Notes" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="Thoughts &amp; Concepts" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding LoadNotesCommand}"
                            Padding="8,6"
                            Margin="0,0,6,0"
                            ToolTip="Refresh Notes">
                        <TextBlock Text="🔄" FontSize="14" />
                    </Button>

                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding NewNoteCommand}"
                            Padding="12,6"
                            ToolTip="Draft New Note">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="New Note" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Search Input -->
                <TextBox Grid.Row="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernTextBox}"
                         Padding="10,8"
                         FontSize="13"
                         Margin="0,0,0,10" />

                <!-- Filter Row (Pinned & Page Selector) -->
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding PageFilterOptions}"
                              SelectedValue="{Binding SelectedPageFilterId}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Title"
                              Padding="6,6"
                              Background="{StaticResource BgInputBrush}"
                              Foreground="{StaticResource TextPrimaryBrush}"
                              Margin="0,0,8,0" />

                    <ToggleButton Grid.Column="1"
                                  IsChecked="{Binding ShowOnlyPinned}"
                                  Padding="10,6"
                                  Cursor="Hand"
                                  Background="{StaticResource BgInputBrush}"
                                  BorderBrush="{StaticResource BorderLightBrush}"
                                  ToolTip="Filter by Pinned Notes">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📌" FontSize="13" Margin="0,0,4,0" />
                            <TextBlock Text="Pinned" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>

                <!-- Loading Indicator -->
                <ProgressBar Grid.Row="3" IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisConverter}}"
                             Foreground="{StaticResource AccentPrimaryBrush}" Background="Transparent" BorderThickness="0" />

                <!-- Notes Cards List -->
                <ListBox Grid.Row="3"
                         ItemsSource="{Binding FilteredNotes}"
                         SelectedItem="{Binding SelectedNoteSummary}"
                         Background="Transparent"
                         BorderThickness="0"
                         Margin="0,4,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="cardBorder"
                                                Background="{StaticResource BgInputBrush}"
                                                BorderBrush="{StaticResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="12,10"
                                                Cursor="Hand">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBorder" Property="Background" Value="{StaticResource BgHoverBrush}" />
                                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource BorderAccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="cardBorder" Property="Background" Value="#222B45" />
                                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource AccentPrimaryBrush}" />
                                                <Setter TargetName="cardBorder" Property="BorderThickness" Value="1.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type dtos:NoteSummaryDto}">
                            <Border>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.SelectNoteCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Title + Pin -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="📌" FontSize="12" Margin="6,0,0,0"
                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisConverter}}" />
                                    </Grid>

                                    <!-- Middle Row: Snippet -->
                                    <TextBlock Grid.Row="1" Text="{Binding ContentSnippet}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" MaxHeight="34" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" Margin="0,4,0,6" />

                                    <!-- Bottom Row: Meta Badge -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Border Background="{StaticResource BgCardBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0"
                                                Visibility="{Binding PageTitle, Converter={StaticResource StringNotEmptyToVisConverter}}">
                                            <TextBlock Text="{Binding PageTitle, StringFormat='📄 {0}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                                        </Border>
                                        <TextBlock Text="{Binding CreatedAtUtc, StringFormat='{}{0:MMM dd}'}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- 2. RIGHT COLUMN: Note Editor -->
        <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="24">
            <Grid>
                <!-- When No Note is Selected -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding HasSelectedNote, Converter={StaticResource InverseBoolToVisConverter}}">
                    <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="No Note Selected" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a note from the left, or create a new one to begin capturing ideas." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,20" HorizontalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewNoteCommand}" HorizontalAlignment="Center" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Draft New Note" FontSize="14" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- When Note IS Selected / Active -->
                <Grid Visibility="{Binding HasSelectedNote, Converter={StaticResource BoolToVisConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Feedback Banners -->
                    <Border Grid.Row="0" Background="{StaticResource BgHoverBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentEmeraldBrush}" FontSize="13" FontWeight="Medium" />
                    </Border>
                    <Border Grid.Row="0" Background="#3B1824" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVisConverter}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource AccentRoseBrush}" FontSize="13" FontWeight="Medium" />
                    </Border>

                    <!-- Action Bar Header -->
                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title Input -->
                        <TextBox Grid.Column="0"
                                 Text="{Binding CurrentNoteTitle, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 FontSize="18" FontWeight="Bold" />

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                            <!-- Toggle Pin -->
                            <ToggleButton IsChecked="{Binding CurrentNoteIsPinned}"
                                          Command="{Binding TogglePinCommand}"
                                          Padding="12,8"
                                          Margin="0,0,8,0"
                                          Cursor="Hand"
                                          Background="{StaticResource BgInputBrush}"
                                          BorderBrush="{StaticResource BorderLightBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📌" FontSize="13" Margin="0,0,4,0" />
                                    <TextBlock Text="Pin" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                </StackPanel>
                            </ToggleButton>

                            <!-- Save Button -->
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveNoteCommand}"
                                    Margin="0,0,8,0"
                                    IsEnabled="{Binding IsSaving, Converter={StaticResource InverseBoolConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Save" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <!-- Delete Button -->
                            <Button Style="{StaticResource DangerButton}"
                                    Command="{Binding DeleteNoteCommand}"
                                    Visibility="{Binding CurrentNoteId, Converter={StaticResource BoolToVisConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🗑" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Delete" FontSize="13" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Associated Page Selector & Tags Input -->
                    <Grid Grid.Row="2" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Page Association -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Attach to Page (Optional)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding PageFilterOptions}"
                                      SelectedValue="{Binding CurrentNotePageId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Title"
                                      Padding="8,8"
                                      Background="{StaticResource BgInputBrush}"
                                      Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Tags Field -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Tags (Comma separated)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding CurrentNoteTags, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Padding="10,8"
                                     FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <!-- AI Intelligence Quick Actions -->
                    <Border Grid.Row="3" Background="{StaticResource BgDarkBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🧠 AI WORKFLOWS:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                <Button Content="✨ Summarize" Command="{Binding RunAiOperationOnNoteCommand}" CommandParameter="Summarize" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="💡 Explain" Command="{Binding RunAiOperationOnNoteCommand}" CommandParameter="Explain" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="📌 Key Points" Command="{Binding RunAiOperationOnNoteCommand}" CommandParameter="Extract Key Points" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="❓ Quiz" Command="{Binding RunAiOperationOnNoteCommand}" CommandParameter="Generate Questions" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" />
                                <Button Content="🎓 Study Guide" Command="{Binding RunAiOperationOnNoteCommand}" CommandParameter="Study Material" Style="{StaticResource SecondaryButton}" Padding="8,4" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Markdown Note Content Editor -->
                    <Border Grid.Row="4" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderLightBrush}" BorderThickness="1" CornerRadius="8">
                        <TextBox Text="{Binding CurrentNoteContent, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 CaretBrush="{StaticResource AccentPrimaryBrush}"
                                 BorderThickness="0"
                                 Padding="16"
                                 FontSize="14"
                                 FontFamily="Segoe UI, Inter, Roboto" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
