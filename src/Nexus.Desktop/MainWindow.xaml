<Window x:Class="Nexus.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Nexus.Desktop.ViewModels"
        xmlns:views="clr-namespace:Nexus.Desktop.Views"
        mc:Ignorable="d"
        Title="NEXUS — AI Knowledge &amp; Learning Workspace"
        Height="800" Width="1280"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkestBrush}">

    <Window.Resources>
        <!-- DataTemplates for ViewModel Navigation Mapping -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <views:RegisterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkspaceSelectorViewModel}">
            <views:WorkspaceSelectorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PagesViewModel}">
            <views:PagesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NotesViewModel}">
            <views:NotesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DocumentsViewModel}">
            <views:DocumentsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BoardsViewModel}">
            <views:BoardsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:MindMapsViewModel}">
            <views:MindMapsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StudyViewModel}">
            <views:StudyView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SearchViewModel}">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AiAssistantViewModel}">
            <views:AiAssistantView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- When Authenticated: Standard 3-Column Shell -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVisConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 1. LEFT SIDEBAR -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarGradientBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Workspace Header / Switcher -->
                    <Border Grid.Row="0"
                            Background="{StaticResource BgCardBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,14"
                            Cursor="Hand">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding SwitchWorkspaceCommand}" />
                        </Border.InputBindings>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding CurrentWorkspaceIcon}"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentWorkspaceName}"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="Switch Workspace ▾"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Navigation Items List -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,16">
                        <StackPanel>
                            <!-- Home -->
                            <RadioButton Style="{StaticResource NavButton}"
                                         IsChecked="True"
                                         Command="{Binding NavigateHomeCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" FontSize="16" Margin="0,0,12,0" />
                                    <TextBlock Text="Home" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Pages & Structure -->
                            <RadioButton Style="{StaticResource NavButton}"
                                         Command="{Binding NavigatePagesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📄" FontSize="16" Margin="0,0,12,0" />
                                    <TextBlock Text="Pages &amp; Docs" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Notes -->
                            <RadioButton Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateNotesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📝" FontSize="16" Margin="0,0,12,0" />
                                    <TextBlock Text="Knowledge Notes" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Documents / Library -->
                            <RadioButton Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateDocumentsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📚" FontSize="16" Margin="0,0,12,0" />
                                    <TextBlock Text="Library &amp; Files" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Boards -->
                            <RadioButton Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateBoardsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="16" Margin="0,0,12,0" />
                                    <TextBlock Text="Study Boards" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Mind Maps -->
                            <RadioButton Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateMindMapsCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧠" FontSize="16" Margin="0,0,12,0" />
                                    <TextBlock Text="Mind Maps" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Study Engine -->
                            <RadioButton Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateStudyCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🎓" FontSize="16" Margin="0,0,12,0" />
                                    <TextBlock Text="Study &amp; Quizzes" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Search -->
                            <RadioButton Style="{StaticResource NavButton}"
                                         Command="{Binding NavigateSearchCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍" FontSize="16" Margin="0,0,12,0" />
                                    <TextBlock Text="Knowledge Search" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- User Profile Footer -->
                    <Border Grid.Row="2"
                            Background="{StaticResource BgDarkestBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Width="34" Height="34"
                                    CornerRadius="17"
                                    Background="{StaticResource PrimaryGradientBrush}"
                                    Margin="0,0,10,0">
                                <TextBlock Text="👤"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UserFullName}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding UserEmail}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Logout Button -->
                            <Button Grid.Column="2"
                                    Content="⎋"
                                    ToolTip="Sign Out"
                                    Command="{Binding LogoutCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Padding="8,4"
                                    FontSize="14" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- 2. CENTER CONTENT AREA -->
            <Grid Grid.Column="1" Background="{StaticResource BgDarkBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Grid.Row="0"
                        Background="{StaticResource BgDarkestBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="20,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Quick Search Button/Bar -->
                        <Border Grid.Column="0"
                                Background="{StaticResource BgInputBrush}"
                                BorderBrush="{StaticResource BorderLightBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8"
                                MaxWidth="450"
                                HorizontalAlignment="Left"
                                Cursor="Hand">
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding NavigateSearchCommand}" />
                            </Border.InputBindings>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="Search knowledge workspace (Ctrl + K)..." Foreground="{StaticResource TextMutedBrush}" FontSize="13" />
                            </StackPanel>
                        </Border>

                        <!-- Toggle AI Panel Button -->
                        <Button Grid.Column="1"
                                Content="🤖 AI Assistant"
                                Command="{Binding ToggleAiPanelCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Height="36" />
                    </Grid>
                </Border>

                <!-- Dynamic View Presenter -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" />
            </Grid>

            <!-- 3. RIGHT AI SIDEBAR PANEL -->
            <Border Grid.Column="2"
                    Width="320"
                    Visibility="{Binding IsAiPanelOpen, Converter={StaticResource BoolToVisConverter}}">
                <views:AiAssistantView />
            </Border>
        </Grid>

        <!-- Unauthenticated View Container (Login / Register / Workspace Selector) -->
        <ContentControl Content="{Binding CurrentView}"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource InverseBoolToVisConverter}}" />
    </Grid>
</Window>
