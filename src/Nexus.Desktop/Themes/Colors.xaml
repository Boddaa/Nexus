<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <Color x:Key="BgDarkestColor">#090D16</Color>
    <Color x:Key="BgDarkColor">#0F172A</Color>
    <Color x:Key="BgCardColor">#1E293B</Color>
    <Color x:Key="BgHoverColor">#334155</Color>
    <Color x:Key="BgSidebarColor">#0B1120</Color>
    <Color x:Key="BgInputColor">#162032</Color>

    <!-- Accents -->
    <Color x:Key="AccentPrimaryColor">#6366F1</Color>
    <Color x:Key="AccentPrimaryHoverColor">#4F46E5</Color>
    <Color x:Key="AccentSecondaryColor">#8B5CF6</Color>
    <Color x:Key="AccentCyanColor">#06B6D4</Color>
    <Color x:Key="AccentEmeraldColor">#10B981</Color>
    <Color x:Key="AccentAmberColor">#F59E0B</Color>
    <Color x:Key="AccentRoseColor">#F43F5E</Color>

    <!-- Borders -->
    <Color x:Key="BorderSubtleColor">#1E293B</Color>
    <Color x:Key="BorderLightColor">#334155</Color>
    <Color x:Key="BorderAccentColor">#4F46E5</Color>

    <!-- Text -->
    <Color x:Key="TextPrimaryColor">#F8FAFC</Color>
    <Color x:Key="TextSecondaryColor">#94A3B8</Color>
    <Color x:Key="TextMutedColor">#64748B</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="BgDarkestBrush" Color="{StaticResource BgDarkestColor}" />
    <SolidColorBrush x:Key="BgDarkBrush" Color="{StaticResource BgDarkColor}" />
    <SolidColorBrush x:Key="BgDarkerBrush" Color="#0B1120" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="{StaticResource BgHoverColor}" />
    <SolidColorBrush x:Key="BgSidebarBrush" Color="{StaticResource BgSidebarColor}" />
    <SolidColorBrush x:Key="BgInputBrush" Color="{StaticResource BgInputColor}" />

    <!-- Surface & Card Aliases -->
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource BgCardColor}" />
    <SolidColorBrush x:Key="SurfaceLightBrush" Color="{StaticResource BgHoverColor}" />

    <!-- Accents -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{StaticResource AccentPrimaryColor}" />
    <SolidColorBrush x:Key="AccentPrimaryHoverBrush" Color="{StaticResource AccentPrimaryHoverColor}" />
    <SolidColorBrush x:Key="AccentSecondaryBrush" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="{StaticResource AccentCyanColor}" />
    <SolidColorBrush x:Key="AccentEmeraldBrush" Color="{StaticResource AccentEmeraldColor}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="AccentRoseBrush" Color="{StaticResource AccentRoseColor}" />
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentSecondaryColor}" />
    <SolidColorBrush x:Key="AccentOrangeBrush" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{StaticResource AccentRoseColor}" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{StaticResource BorderLightColor}" />
    <SolidColorBrush x:Key="BorderAccentBrush" Color="{StaticResource BorderAccentColor}" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

    <!-- Gradients -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6366F1" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B1120" Offset="0" />
        <GradientStop Color="#080D1A" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
