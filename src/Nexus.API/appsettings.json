{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=NexusDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "NexusAPI",
    "Audience": "NexusDesktopClient",
    "ExpiryDays": 7
  },
  "FileStorage": {
    "BasePath": ""
  },
  "Embeddings": {
    "Provider": "None",
    "Model": "",
    "Dimensions": 1536,
    "ApiKey": "",
    "Endpoint": ""
  },
  "Chunking": {
    "ChunkSize": 1000,
    "ChunkOverlap": 150
  },
  "Search": {
    "KeywordWeight": 0.5,
    "VectorWeight": 0.5,
    "DefaultTopK": 10,
    "MaxTopK": 50
  },
  "AI": {
    "LLM": {
      "Provider": "None",
      "Model": "gpt-4o-mini",
      "Endpoint": "",
      "ApiKey": "",
      "Temperature": 0.3,
      "MaxTokens": 1500
    },
    "RAG": {
      "RetrievalMode": "Hybrid",
      "TopK": 8,
      "MaxSources": 8,
      "MaxContextCharacters": 6000,
      "MaxConversationMessages": 10,
      "MinimumRelevanceScore": 0.05
    }
  }
}
